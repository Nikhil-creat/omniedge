# Copy to .env.local for local development.
# For a GitHub Pages deployment, set these as repository Actions variables
# (Settings -> Secrets and variables -> Actions -> Variables) so the
# build workflow can inject them.

VITE_OMNIEDGE_API_URL=http://localhost:8000
VITE_OMNIEDGE_WS_URL=ws://localhost:8000/ws/telemetry
VITE_OMNIEDGE_NODE_ID=edge-node-primary
